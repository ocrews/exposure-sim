{
  "schema_version": 1,
  "id": "prairie-freight",
  "name": "Prairie Freight Co.",
  "difficulty": "Hybrid",
  "tagline": "Regional logistics company. Half on-prem data center, half AWS.",
  "briefing": [
    "Prairie Freight runs billing, shipment tracking, and Active Directory in its own data center, and its customer portal in AWS.",
    "Tenable SC scans the Linux servers. A Qualys scanner appliance scans the Windows side and uploads results to Qualys's cloud.",
    "Dev and platform teams work in Jira Data Center, which is internal and not reachable from the internet. Operations teams work in ServiceNow (SaaS).",
    "The CMDB is decent but incomplete. Security policy allows approved SaaS, with outbound 443 only through an egress proxy and no inbound firewall rules."
  ],
  "constraints": {
    "data_must_stay_onprem": false,
    "reason": "SaaS is allowed if it passes vendor review. No inbound connections from the internet."
  },
  "zones": [
    {
      "id": "saas",
      "label": "Internet · SaaS",
      "kind": "saas"
    },
    {
      "id": "aws",
      "label": "AWS VPC",
      "kind": "cloud"
    },
    {
      "id": "dmz",
      "label": "On-prem DMZ",
      "kind": "dmz"
    },
    {
      "id": "servers",
      "label": "On-prem server VLAN",
      "kind": "servers"
    },
    {
      "id": "mgmt",
      "label": "On-prem mgmt VLAN",
      "kind": "mgmt"
    }
  ],
  "collector_zone": "mgmt",
