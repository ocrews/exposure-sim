      "works_in": "jira-cloud",
      "kind": "dev"
    },
    {
      "id": "Payments-Eng",
      "works_in": "jira-cloud",
      "kind": "dev"
    },
    {
      "id": "Data-Platform",
      "works_in": "jira-cloud",
      "kind": "dev"
    },
    {
      "id": "Platform-Eng",
      "works_in": "jira-cloud",
      "kind": "dev"
    },
    {
      "id": "AppDev",
      "works_in": "jira-cloud",
      "kind": "dev"
    },
    {
      "id": "IT-Support",
      "works_in": "snow",
      "kind": "ops"
    }
  ],
  "rules": {
    "crown_jewel": {
      "always": [
        "critical"
      ],
      "if_internet_facing": [
        "high"
      ]
    },
    "p1_sla_days_ok": [
      "7",
      "15"
    ]
  }
}
